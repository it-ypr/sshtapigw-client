  public static function queryConditionSimrs(string $tgl_param, string $rm, string $dok, string $poli_idihs)
  {
    $dbSimrs = Yii::$app->db;

    return (new Query())
      ->select(['k.Id', 'k.rm', 'k.icd', 'k.dok', 'k.poli', 'mpoli.' . SshtApiQueryMapping::MPOLI_IHS . ' as lokasi_ihs'])
      ->from('mr_kunjungan k')
      ->leftJoin('mpoli', 'k.poli = mpoli.poli')
      ->where([
        'k.rm' => $rm,
        'k.dok' => $dok,
        'k.tanggal' => $tgl_param,
        // 'mpoli.idssht' => $poli_idihs,
        'mpoli.' . SshtApiQueryMapping::MPOLI_IHS => $poli_idihs,
      ])
      ->orderBy("Id ASC")
      ->all($dbSimrs);
  }

  // query-observation-diagnosticreport RAD
  // observation & diagnostic report RAD
  public static function queryObservationDanDiagnosticReportSimrsRadio(string $noradio)
  {
    $dbSimrs = Yii::$app->db; // dbSimrs

    return (new Query())
      ->select(['b.rm', 'h.hasil'])
      ->from('rd_hasil h')
      ->leftJoin('rd_biodata b', 'h.noradio = b.noradio')
      ->where(['h.noradio' => $noradio, 'h.ondelete' => 0])
      ->one($dbSimrs);
  }

  /**
   * Query lokal observation rawat jalan
   * @param string $tanggal
   */
  public static function queryObservationRalan(string $tanggal, string $rm)
  {
    $db1 = Yii::$app->db;

    $result = (new Query())
      ->select([
        't1.Id',
        't1.rm',
        't2.nama',
        't1.tanggal',
        't1.dokter',
        't1.poli',
        't3.rl_user',
        't1.jenis',
        't1.textisi',
      ])
      ->from(['t1' => 'mr_medis_rtf'])
      ->leftJoin(['t2' => 'mmr'], 't1.rm = t2.rm')
      ->leftJoin(['t3' => 'muser'], 't1.dokter = t3.id_user')
      ->where([
        't1.tanggal' => $tanggal,
        't1.rm' => $rm,
        't1.jenis' => 'KO'
      ])
      ->one($db1);

    if (!$result) {
      return false;
    }

    $data['tanggal'] = $result['tanggal'];
    $data['rm'] = $result['rm'];
    $data['nama'] = $result['nama'];
    $data['kode_dokter'] = $result['dokter'];
    $data['nama_dokter'] = $result['rl_user'];
    $data['jenis'] = $result['jenis'];
    $data['poli'] = $result['poli'];

    // parse kolom texisi
    // $data['td_sistolik'] = $result['dsfasdfad'];
    // $data['td_diastolik'] = $result['dsfasdfad'];
    // $data['suhu_tubuh'] = $result['dsfasdfad'];
    // $data['denyut_jantung'] = $result['dsfasdfad'];
    // $data['pernafasan'] = $result['dsfasdfad'];
    $data['observation_data'] = SshtApiUtil::parseObservation($result['textisi']);

    return $data;
  }

  public static function queryProcedureGeneral(string $tanggal, string $rm)
  {
    $db1 = Yii::$app->db;
    $result = (new Query())
      ->select([
        't2.tanggal',
        't2.rm',
        't3.nama',
        't1.id_casemix',
        't2.Id',
        't1.kode_icd',
        't1.procedure',
        't2.dokter',
        't4.rl_user',
        't2.poli',
      ])
      ->from(['t1' => 'mr_casemix_ralan_pc'])
      ->leftJoin(['t2' => 'mr_casemix_ralan'], 't1.id_casemix = t2.Id')
      ->leftJoin(['t3' => 'mmr'], 't2.rm = t3.rm')
      ->leftJoin(['t4' => 'muser'], 't2.dokter = t4.id_user')
      ->where([
        't2.tanggal' => $tanggal,
        't2.rm' => $rm,
      ])
      ->all($db1);

    if (!$result) {
      return false;
    }

    $first = $result[0];
    $procedures = [];
    $seen = [];

    foreach ($result as $row) {
      $icd9 = trim((string) $row['kode_icd']);
      $desc = trim((string) $row['procedure']);
      $key = $icd9 . "\0" . $desc;

      if (isset($seen[$key])) {
        continue;
      }

      $seen[$key] = true;
      $procedures[] = [
        'icd9' => $icd9,
        'desc' => $desc,
      ];
    }

    $data['tanggal'] = $first['tanggal'];
    $data['rm_pasien'] = $first['rm'];
    $data['nama_pasien'] = $first['nama'];
    $data['kode_dokter'] = $first['dokter'];
    $data['nama_dokter'] = $first['rl_user'];
    $data['procedures'] = $procedures;
    $data['kode_poli'] = $first['poli'];

    return $data;
  }

  public static function queryLabRalan(string $tanggal, string $rm)
  {
    // query 1
    $result1 = (new Query())
      ->select([
        'lnb.Id',
        'lnb.rm',
        'lnb.nama',
        'lnb.tanggal',
        'lnb.NoTest',
        'lnb.d_kirim', // dokter request
        'lnb.d_nkirim', // nama dokter
        'muser.' . SshtApiQueryMapping::MUSER_IHS . ' as petugas_ihs',
        'muser.nm_user as petugas_nama',
      ])
      ->from(['lnb' => 'lab_newbiodata'])
      ->leftJoin('muser', 'lnb.id_user = muser.nik')
      ->where([
        'lnb.tanggal' => $tanggal,
        'lnb.rm' => $rm,
      ])
      ->one(Yii::$app->db);

    // query 2
    $result2 = (new Query())
      ->select([
        'lop.Id',
        'lop.rm',
        'lop.tanggal',
        'ldp.nama',
        'lm.kode_rs',
        'lm.loinc_code',
        // 'll.display as loinc_display',
        // // 'll.kategori_kelompok_pemeriksaan',
        // // 'll.nama_pemeriksaan',
        // 'll.permintaan_hasil',
        // 'll.tipe_hasil_pemeriksaan',
        // 'll.spesimen',
        // 'll.specimen_code',
        // 'ss.display as specimen_display',
      ])
      ->from(['lop' => 'lab_order_poli'])
      ->innerJoin(['ldp' => 'lab_daftar_periksa'], 'lop.kode = ldp.kode')
      ->innerJoin(['lm' => 'loinc_map'], 'ldp.kode = lm.kode_rs')
      // ->innerJoin(['ll' => 'loinc_lab'], 'lm.loinc_code = ll.code')
      // ->innerJoin(['ss' => 'snomed_specimen'], 'll.specimen_code = ss.code')
      ->where([
        'lop.tanggal' => $tanggal,
        'lop.rm' => $rm,
      ])
      ->all(Yii::$app->db);
    // return [$result1, $result2];

    if (!$result1 || !$result2) {
      return false;
    }

    // get Loinc lab & speciment dari dbterminologi:
    $loincCodes = array_unique(array_column($result2, 'loinc_code'));

    $loincRows = (new Query())
      ->from('loinc_lab')
      ->where(['code' => $loincCodes])
      ->all(Yii::$app->dbsshtterminologi);

    $loincMap = [];
    $specimenCodes = [];

    foreach ($loincRows as $row) {
      $loincMap[$row['code']] = $row;
      $specimenCodes[] = $row['specimen_code'];
    }

    $specimenRows = (new Query())
      ->from('snomed_specimen')
      ->where(['code' => array_unique($specimenCodes)])
      ->all(Yii::$app->dbsshtterminologi);

    $specimenMap = [];
    foreach ($specimenRows as $row) {
      $specimenMap[$row['code']] = $row;
    }

    // $first = $result1[0]; // get first data for prerequisites
    $data['prereq'] = [
      'tanggal' => $tanggal,
      'rm_pasien' => $rm,
      'nama_pasien' => $result1['nama'], // mmr.nama
      'kode_dokter' => $result1['d_kirim'], // muser.id_user
      'nama_dokter' => $result1['d_nkirim'], // muser.rl_user
      'class' => 'AMB', // ambulatory (rawat jalan)
      'petugas_ihs' => $result1['petugas_ihs'],
      'petugas_nama' => $result1['petugas_nama']
    ];

    $labResult = [];
    foreach ($result2 as $row) {

      // join data loinc lab & specimen
      $loinc = $loincMap[$row['loinc_code']] ?? [];
      $specimen = $specimenMap[$loinc['specimen_code'] ?? ''] ?? [];

      $labResult[] = [
        'svc_req' => [
          'nama_lokal' => $row['nama'],
          'service_req_code' => $result1['NoTest'] . 'Q' . $row['kode_rs'],
          'loinc_order_code' => $row['loinc_code'],
          'loinc_order_display' => $loinc['display'] ?? null,
          // 'loinc_order_display' => $row['loinc_display'],
          'kategori' => 'lab',
        ],
        'specimen' => [
          // 'sample_id' => $result1['NoTest'] . '-' . $row['specimen_code'],
          // 'specimen_code' => $row['specimen_code'],
          // 'specimen_display' => $row['specimen_display'],
          // 'sampling_method' => $row['spesimen'],
          'sample_id' => $result1['NoTest'] . '-' . ($loinc['specimen_code'] ?? ''),
          'specimen_code' => $loinc['specimen_code'] ?? null,
          'specimen_display' => $specimen['display'] ?? null,
          'sampling_method' => $loinc['spesimen'] ?? null,
        ],
      ];
    }
    $data['lab_result'] = $labResult;

    return $data;
  }

  public static function queryMedicationRalan(string $tgl_param, string $rm_param)
  {
    $db1 = Yii::$app->db;

    $sub = (new Query())
      ->select([
        'fb.Id',
        'fb.tanggal',
        'fb.resep',
        'fb.nama',
        'fb.rm',
        'fb.kddokter',
        'fb.petugas',
        'fb.id_user'
        // 'fb.id_ambil',
      ])
      ->from(['fb' => 'frm_biodata'])
      ->where([
        'fb.tanggal' => $tgl_param
      ]);

    $query = (new Query())
      ->select([
        'fr.Id',
        'fbio.resep',
        'fbio.rm',
        'fbio.tanggal',
        'fbio.kddokter',
        'fr.resep as fr_resep',
        // 'rob.id_local',
        'lg.Id as id_local',
        'rob.medication_idIHS',
        'lg.kode_brg',
        'lg.nama',
        'rob.kfa_code',
        'rob.kfa_display',
        'fr.jumlah',
        'fr.kali',
        'fr.hari',
        'fr.sediaan',
        'fr.waktu',
        'rob.kfa_bza',
        'rob.kfa_ucum',
        'rob.kfa_uom',
        'rob.kfa_route',
        'rob.kfa_form',
        'md.' . SshtApiQueryMapping::MUSER_IHS . ' as ihs_dok',
        'mp.' . SshtApiQueryMapping::MUSER_IHS . ' as ihs_petugas',
        'mp.nm_user as petugas_nama',
        'ma.' . SshtApiQueryMapping::MUSER_IHS . ' as ihs_petugas_ambil',
        'ma.nm_user as petugas_ambil_nama'
      ])
      ->from(['fbio' => $sub])
      ->leftJoin('frm_ralan as fr', 'fbio.resep = fr.resep and fbio.tanggal = fr.tanggal')
      ->leftJoin('log_gudang as lg', 'fr.kode_brg = lg.kode_brg')
      ->leftJoin('ref_obat_briging as rob', 'lg.Id = rob.id_local')
      ->leftJoin('muser as md', 'fbio.kddokter = md.nik')
      ->leftJoin('muser as mp', 'fbio.id_user = mp.nik')
      // ->leftJoin('muser as ma', 'fbio.id_ambil = ma.nik')
      ->leftJoin('muser as ma', 'fbio.petugas = ma.nik')
      ->where(['fbio.rm' => $rm_param]);

    $data = $query->all($db1);

    if (!$data) {
      return false;
    }

    return $data;
  }

  public static function getRefObatByLocalId(string $localid)
  {
    $db1 = Yii::$app->db;

    $result = (new Query())
      ->select([
        'rob.Id',
        'rob.id_local',
        'rob.medication_idIHS',
        'rob.kfa_code',
        'rob.kfa_display',
        'rob.kfa_system',
        'rob.kfa_bza',
        'rob.kfa_form',
        'rob.kfa_route'
      ])
      ->from(['rob' => 'ref_obat_briging'])
      ->where([
        'rob.id_local' => $localid,
      ])
      ->one($db1);

    if (!$result) {
      return false;
    }

    return $result;
  }

  public static function getObservationLabLocalRalan(
    string $tgl_param,
    string $rm,
    string $loinc_order
  ) {
    // query 1
    $result1 = (new Query())
      ->select([
        'lnb.Id',
        'lnb.rm',
        'lnb.nama',
        'lnb.tanggal',
        'lnb.NoTest',
      ])
      ->from(['lnb' => 'lab_newbiodata'])
      ->leftJoin('muser m', 'lnb.id_user = m.nik')
      ->where([
        'lnb.tanggal' => $tgl_param,
        'lnb.rm' => $rm,
      ])
      ->one(Yii::$app->db);

    if (!$result1) {
      return false;
    }

    // query 2
    $result2 = (new Query())
      ->select([
        'lh.SAMPEL_ID',
        'lh.PASIEN_ID as rm',
        'lh.TEST_ID',
        'lh.RESULT_VALUE',
        'lh.SATUAN',
        'lh.ANGKA_NORMAL as referenceRange',
        // 'lh.METODE',
        'lmh.id_lab',
        'lmh.loinc_code',
        'llo.loinc_order_code',
        // 'll.nama_pemeriksaan',
        // 'll.spesimen',
        // 'll.display',
        // 'll.tipe_hasil_pemeriksaan as scale',
        // 'll.metode_analisis as metode',
      ])
      ->from(['lh' => 'lis_hasil'])
      ->innerJoin(['lmh' => 'loinc_map_hasil'], 'lh.TEST_ID = lmh.id_lab')
      ->innerJoin(['llo' => 'loinc_lab_order'], 'lmh.loinc_code = llo.loinc_code')
      // ->innerJoin(['ll' => 'loinc_lab'], 'lmh.loinc_code = ll.code')
      ->where([
        'lh.SAMPEL_ID' => $result1['NoTest'],
        'llo.loinc_order_code' => $loinc_order,
      ])
      ->all(Yii::$app->db);

    // get Loinc lab & speciment dari dbterminologi:
    $loincCodes = array_unique(array_column($result2, 'loinc_code'));

    $loincRows = (new Query())
      ->from('loinc_lab')
      ->where(['code' => $loincCodes])
      ->all(Yii::$app->dbsshtterminologi);

    $loincMap = [];

    foreach ($loincRows as $row) {
      $loincMap[$row['code']] = $row;
    }

    // $data = $result2;

    if (!$result2) {
      return false;
    }

    // Merge data terminologi ke hasil query
    $data = [];

    foreach ($result2 as $row) {

      // join loinc data
      $loinc = $loincMap[$row['loinc_code']] ?? [];

      // require..
      // 'll.nama_pemeriksaan',
      // 'll.spesimen',
      // 'll.display',
      // 'll.tipe_hasil_pemeriksaan as scale',
      // 'll.metode_analisis as metode',

      $data[] = array_merge($row, [
        'nama_pemeriksaan' => $loinc['nama_pemeriksaan'] ?? null,
        'spesimen' => $loinc['spesimen'] ?? null,
        'display' => $loinc['display'] ?? null,
        'scale' => $loinc['tipe_hasil_pemeriksaan'] ?? null,
        'metode' => $loinc['metode_analisis'] ?? null,
      ]);
    }

    return $data;
  }
}
